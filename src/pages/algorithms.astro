---
import BookLayout from '../layouts/BookLayout.astro';
import { algorithmNavigation, noteUrl } from '../lib/notes';
---
<BookLayout title="알고리즘" description="알고리즘 학습 노트" category="algorithms" next={{ title: algorithmNavigation[0].items[0].title, href: noteUrl(algorithmNavigation[0].items[0].id) }}>
  <header class="page-header"><h1>2 Algorithms</h1></header>
  <div class="chapter-list">
    {algorithmNavigation.map(group => <section>
      <h2>{group.number} {group.title}</h2>
      <ul>{group.items.map(item => <li><a href={noteUrl(item.id)}><span>{item.number}</span>{item.title}<span aria-hidden="true">›</span></a></li>)}</ul>
    </section>)}
  </div>
</BookLayout>
